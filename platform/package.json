{
  "name": "rebito",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "build": "npm run runtimes && tsc -p tsconfig.build.json && vite build",
    "runtimes": "node scripts/runtime-assets.mjs",
    "start": "node dist/server/main.js",
    "dev": "node --watch --experimental-strip-types src/server/main.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.client.json",
    "dev:web": "vite",
    "lint": "biome check . && cd .. && biome check --config-path=platform scripts",
    "format": "biome check --write . && cd .. && biome check --write --config-path=platform scripts",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@primeuix/themes": "1.2.5",
    "better-auth": "1.7.18",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "primevue": "4.5.5",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "fflate": "0.8.3",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-i18n": "11.4.20",
    "vue-tsc": "3.3.14"
  }
}
