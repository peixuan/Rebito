# Replace game.example.net and obtain its certificate before enabling TLS.
server {
    listen 80;
    server_name game.example.net;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://game.example.net:62001$request_uri; }
}
server {
    listen 62001 ssl http2;
    server_name game.example.net;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/game.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/game.example.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1025m;
    client_body_timeout 900s;
    location / {
        if (-f /var/lib/rebito/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
