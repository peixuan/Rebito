[Unit]
Description=Deploy a verified Rebito release
Wants=network-online.target
After=network-online.target docker.service nginx.service
Requires=docker.service
ConditionPathExists=/var/lib/rebito/release.json

[Service]
Type=oneshot
EnvironmentFile=/etc/rebito/deploy.env
Environment=PYTHONUNBUFFERED=1
Environment=DOCKER_CONFIG=/var/lib/rebito/docker-cli
ExecStart=/usr/bin/python3 -B /opt/rebito/deployer/deploy.py ${REBITO_REPOSITORY}
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/rebito /var/lib/rebito /var/lib/docker
