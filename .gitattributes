# Normalize text files in the repository.
* text=auto

# Use LF for repository configuration files.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Use LF for Markdown files.
*.[mM][dD] text eol=lf

# Use CRLF for Windows command scripts.
*.[bB][aA][tT] text eol=crlf
*.[cC][mM][dD] text eol=crlf

# Portable hooks, JavaScript tooling and container/CI configuration.
.githooks/* text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.html text eol=lf
*.css text eol=lf
.dockerignore text eol=lf
LICENSE text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.example text eol=lf
